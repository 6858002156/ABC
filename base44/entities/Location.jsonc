{
  "name": "Location",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "mall",
        "airport",
        "landmark",
        "beach",
        "city",
        "hotel",
        "transit"
      ]
    },
    "address": {
      "type": "string"
    },
    "province": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "category",
    "lat",
    "lng"
  ]
}