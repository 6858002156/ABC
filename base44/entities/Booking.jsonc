{
  "name": "Booking",
  "type": "object",
  "properties": {
    "station_id": {
      "type": "string"
    },
    "station_name": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "duration_minutes": {
      "type": "integer"
    },
    "connector_type": {
      "type": "string"
    },
    "estimated_cost": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "active",
        "completed",
        "cancelled"
      ]
    }
  },
  "required": [
    "station_id",
    "station_name",
    "brand",
    "start_time",
    "duration_minutes",
    "status"
  ]
}