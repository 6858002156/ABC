{
  "name": "WalletTransactions",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Top-Up",
        "Charging-Deduction"
      ],
      "enumColors": [
        "green",
        "red"
      ]
    },
    "amount_thb": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "PromptPay QR",
        "Credit Card"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Completed",
        "Failed"
      ],
      "default": "Completed",
      "enumColors": [
        "yellow",
        "green",
        "red"
      ]
    },
    "reference_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "type",
    "amount_thb",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}