{
  "name": "Post",
  "type": "object",
  "properties": {
    "content": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "post",
        "tip",
        "checkin",
        "review"
      ],
      "default": "post"
    },
    "station_name": {
      "type": "string"
    },
    "likes": {
      "type": "integer",
      "default": 0
    },
    "image_url": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}